{
	"geode": "5.5.2",
	"gd": {
		"win": "2.2081",
		"android": "2.2081",
		"mac": "2.2081",
		"ios": "2.2081"
	},
	"id": "joseii.ventilla",
	"name": "Ventilla",
	"version": "v2.0.2",
	"developer": "JoseII",
	"description": "Play a 24/7 Live Radio in the Main Menu!",
	"links": {
		"source": "https://github.com/JoseIIS/Ventilla",
		"homepage": "https://radio.5infin.es",
		"community": "https://discord.gg/MBGX5BTEU7"
	},
	"tags": [
		"universal", "gameplay", "editor", "online", "enhancement", "music", "interface", "customization"
	],
	"resources": {
		"sprites": [
			"resources/*.png"
		]
	},
	"dependencies": {
		"geode.node-ids": ">=1.23.0"
	},
	"settings": {
		"enabled": {
			"name": "Enable Radio",
			"type": "bool",
			"default": true
		},
		"volume": {
			"name": "Radio Volume",
			"type": "int",
			"default": 65,
			"control": {
				"slider-step": 1,
				"arrows": false,
				"slider": true
			},
			"min": 0,
			"max": 100
		},
		"play-in-editor": {
			"name": "Play in Editor",
			"type": "bool",
			"default": false
		},
		"play-in-practice-mode": {
			"name": "Play in Practice Mode",
			"type": "bool",
			"default": false
		},
		"play-in-normal-mode": {
			"name": "Play in Normal Mode",
			"type": "bool",
			"default": false
		},
		"play-in-pause-menu": {
			"name": "Play in Pause Menu",
			"type": "bool",
			"default": false
		},
		"play-in-background": {
			"name": "Play in Background",
			"type": "bool",
			"default": false,
			"platforms": [
				"mac",
				"win"
			]
		},
		"show-button-in-main-menu": {
			"name": "Show Button In Main Menu",
			"type": "bool",
			"default": true
		},
		"show-button-in-pause-menu": {
			"name": "Show Button In Pause Menu",
			"type": "bool",
			"default": true
		},
		"show-button-in-editor-pause": {
			"name": "Show Button In Editor Pause",
			"type": "bool",
			"default": true
		},
		"fade-in": {
			"name": "Fade In Radio",
			"type": "bool",
			"default": true
		},
		"shop.mp3": {
			"name": "Play Radio in The Shop",
			"type": "bool",
			"default": false
		},
		"tower01.mp3": {
			"name": "Play Radio in The Tower",
			"type": "bool",
			"default": false
		},
		"secretLoop02.mp3": {
			"name": "Play Radio in The Vault of Secrets",
			"type": "bool",
			"default": false
		},
		"secretLoop03.mp3": {
			"name": "Play Radio in The Chamber of Time",
			"type": "bool",
			"default": false
		},
		"secretLoop04.mp3": {
			"name": "Play Radio in The Wraith",
			"type": "bool",
			"default": false
		},
		"secretShop.mp3": {
			"name": "Play Radio in The Secret Shop",
			"type": "bool",
			"default": false
		},
		"shop3.mp3": {
			"name": "Play Radio in The Community Shop",
			"type": "bool",
			"default": false
		},
		"shop4.mp3": {
			"name": "Play Radio in The Mechanic Shop",
			"type": "bool",
			"default": false
		},
		"shop5.mp3": {
			"name": "Play Radio in The Diamond Shop",
			"type": "bool",
			"default": false
		},
		"secretLoop.mp3": {
			"name": "Play Radio in The Treasure Room & The Vault",
			"type": "bool",
			"default": false
		},
		"extras": {
			"name": "Play Radio in Other Menus",
			"type": "bool",
			"default": false
		}
	}
}
